{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "adapter",
    "runtime",
    "brief",
    "agents",
    "skills",
    "inputs",
    "resources",
    "required_outputs",
    "policy"
  ],
  "properties": {
    "format": {
      "const": "research-package/v3"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "adapter": {
      "enum": [
        "fixture",
        "codex"
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "sdk"
      ],
      "dependentRequired": {
        "image": [
          "image_id"
        ],
        "image_id": [
          "image"
        ]
      },
      "properties": {
        "image": {
          "type": "string"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sdk": {
          "const": "openai-codex==0.159.0"
        }
      }
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
    },
    "agents": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu",
        "memory_mb",
        "time_seconds"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "memory_mb": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32768
        },
        "time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "outputs/result.json"
          }
        },
        {
          "contains": {
            "const": "outputs/handoff.md"
          }
        }
      ]
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "finalization_seconds": {
          "exclusiveMinimum": 0,
          "title": "Finalization Seconds",
          "type": "number"
        },
        "termination_seconds": {
          "exclusiveMinimum": 0,
          "title": "Termination Seconds",
          "type": "number"
        },
        "checkpoint_seconds": {
          "maximum": 300,
          "minimum": 0.1,
          "title": "Checkpoint Seconds",
          "type": "number"
        }
      },
      "required": [
        "finalization_seconds",
        "termination_seconds",
        "checkpoint_seconds"
      ],
      "title": "Policy",
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_type": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "title": "Asset Type",
            "type": "string"
          },
          "asset_id": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Asset Id",
            "type": "string"
          },
          "destination": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "asset_type",
          "asset_id",
          "destination"
        ],
        "title": "AssetDependency",
        "type": "object"
      }
    },
    "tool_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "containerfile",
          "context",
          "platform",
          "inputs",
          "tag",
          "timeout_seconds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "containerfile": {
            "type": "string",
            "minLength": 1,
            "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
          },
          "platform": {
            "type": "string",
            "pattern": "^linux/[a-z0-9]+$"
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 128,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "fetch": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "dest"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "url_from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "dest": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Normalized relative POSIX path; no traversal, links or reserved input paths."
                }
              }
            }
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7200
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "description": "research-package/v3 is v2 plus optional tool_images, required_checks and provenance. Tag, hash, path and archive constraints are checked by research-runner verify."
}
